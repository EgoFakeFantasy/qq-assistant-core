{
  "name": "qq-assistant-core",
  "version": "0.2.0",
  "private": true,
  "description": "QQ research assistant core: private textbook retrieval, autonomous Bilibili exploration and scoped platform accounts",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EgoFakeFantasy/qq-assistant-core.git"
  },
  "homepage": "https://github.com/EgoFakeFantasy/qq-assistant-core#readme",
  "keywords": [
    "codex",
    "claude-code",
    "qq",
    "onebot",
    "napcat"
  ],
  "scripts": {
    "init": "node scripts/init-assistant.mjs",
    "start": "node profiles/set-theory/offline-demo.mjs",
    "start:live": "node profiles/set-theory/start-live.mjs --live --config private/live-config.json",
    "accounts": "node profiles/set-theory/start-account-panel.mjs",
    "accounts:token": "node scripts/account-token.mjs",
    "health": "node deployment/runtime-health.mjs",
    "check": "node scripts/check-core.mjs",
    "test": "node scripts/run-core-tests.mjs",
    "test:core": "node scripts/run-core-tests.mjs",
    "test:upstream": "node --test test",
    "verify": "npm run check && npm run test:core && npm run test:channels && npm run test:operations",
    "verify:knowledge": "python -m unittest discover -s tools -p test_*.py",
    "audit:public": "node scripts/audit-public.mjs",
    "test:channels": "node scripts/run-supplemental-tests.mjs channels",
    "prepare:official": "node scripts/prepare-qq-official.mjs",
    "check:official": "node scripts/check-qq-official.mjs",
    "prepare:llbot": "node scripts/prepare-llbot.mjs",
    "test:operations": "node scripts/run-supplemental-tests.mjs operations"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.2",
    "qrcode": "1.5.4",
    "@tencent-connect/qqbot-nodejs": "1.0.5"
  }
}
